# Secrets for rclone (Google Drive). Copy to .env and fill in — .env is gitignored.
#
# Every value here is secret and must NOT be committed. The non-secret rclone
# settings live in rclone/rclone.env; rclone is always run with an empty config
# (--config=), so those files are the only source of configuration.

# Your own Google OAuth client. Recommended: rclone's shared client_id is being
# retired during 2026. Create a Desktop-app client at
# https://console.cloud.google.com with the Drive API enabled (see docs/rclone.md).
RCLONE_CONFIG_GDRIVE_CLIENT_ID=
RCLONE_CONFIG_GDRIVE_CLIENT_SECRET=

# OAuth token JSON printed by `rclone authorize drive <id> <secret>`.
# Keep it on one line wrapped in single quotes so both the shell and systemd's
# EnvironmentFile parse it correctly.
RCLONE_CONFIG_GDRIVE_TOKEN='{"access_token":"","token_type":"Bearer","refresh_token":"","expiry":"0001-01-01T00:00:00Z"}'
