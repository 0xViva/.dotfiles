#!/bin/bash
# Start Hyprland with the dotfiles config, without uwsm or a vendor session.
set -e

export GDK_SCALE=2
export EDITOR=nvim
export TERMINAL=alacritty
export HYPR_TERMINAL=alacritty
export HYPR_BROWSER=chromium
export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_DESKTOP=Hyprland
export XDG_SESSION_TYPE=wayland

exec /usr/bin/start-hyprland
