#!/bin/bash
# Apply a power profile on AC/battery changes. Native power-profiles-daemon.

set -euo pipefail

command -v powerprofilesctl >/dev/null || exit 0

apply() {
    local profile
    if [[ $(busctl get-property org.freedesktop.UPower /org/freedesktop/UPower org.freedesktop.UPower OnBattery 2>/dev/null) == "b true" ]]; then
        profile=balanced
    else
        profile=performance
    fi
    powerprofilesctl set "$profile" || powerprofilesctl set balanced
}

# UPower may not be ready when the user service starts.
for _ in {1..20}; do
    apply && break
    sleep 1
done

stdbuf -oL dbus-monitor --system \
    "type='signal',interface='org.freedesktop.DBus.Properties',path='/org/freedesktop/UPower',member='PropertiesChanged'" |
    while IFS= read -r line; do
        [[ $line == *OnBattery* ]] || continue
        apply || true
    done
