#!/usr/bin/env bash
# Snapshot the entire Google Drive remote one-way into
# ~/backups/google_drive/google-drive_YYYY-MM-DD_HH-MM-SS.
#
# rclone runs with an empty config (--config=) and reads everything from the
# environment: non-secret settings from rclone/rclone.env, secrets from the
# repo-root .env. Nothing secret is ever written to disk.
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)"

# shellcheck source=/dev/null
set -a; source "$repo_root/rclone/rclone.env"; set +a

if [[ ! -f "$repo_root/.env" ]]; then
    echo "rclone-backup: $repo_root/.env not found — copy .env.example and fill it in." >&2
    exit 1
fi
# shellcheck source=/dev/null
set -a; source "$repo_root/.env"; set +a

if [[ -z "${RCLONE_CONFIG_GDRIVE_TOKEN:-}" ]]; then
    echo "rclone-backup: RCLONE_CONFIG_GDRIVE_TOKEN is not set in $repo_root/.env" >&2
    exit 1
fi

backup_root="${RCLONE_BACKUP_ROOT:-$HOME/backups/google_drive}"
snapshot="google-drive_$(date +%Y-%m-%d_%H-%M-%S)"
dest="$backup_root/$snapshot"
keep="${RCLONE_BACKUP_KEEP:-2}"

# If the copy doesn't finish, remove the incomplete snapshot so a failed run
# never leaves an empty or partial google-drive_* directory behind (which would
# otherwise be counted, and could evict a good snapshot during retention).
backup_ok=false
cleanup() {
    if [[ "$backup_ok" != true && -n "$dest" && -e "$dest" ]]; then
        echo "rclone-backup: copy failed; removing incomplete snapshot $dest" >&2
        rm -rf -- "$dest"
    fi
}
trap cleanup EXIT

mkdir -p "$dest"
echo "Backing up gdrive: -> $dest"

rclone --config= copy gdrive: "$dest" \
    --create-empty-src-dirs \
    --stats-one-line \
    --stats 15s

backup_ok=true
echo "Done: $dest"

# Retention: keep the newest $keep snapshots (RCLONE_BACKUP_KEEP; 0 = keep all).
# Runs only after a successful copy, and only ever deletes directories named
# google-drive_* directly under backup_root — so the snapshot just written can
# never be the one removed. Zero-padded names sort chronologically.
if [[ "$keep" =~ ^[0-9]+$ ]] && (( keep > 0 )); then
    shopt -s nullglob
    snapshots=( "$backup_root"/google-drive_*/ )
    shopt -u nullglob
    total=${#snapshots[@]}
    if (( total > keep )); then
        for (( i = 0; i < total - keep; i++ )); do
            old="${snapshots[i]%/}"
            echo "Pruning old snapshot: $old"
            rm -rf -- "$old"
        done
    fi
fi
