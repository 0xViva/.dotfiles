#!/bin/sh
# rex-browser: open a URL in a text-mode browser inside a Rex pane.
#
# Usage:
#   rex-browser [options] URL...
#
# Options:
#   --browser NAME        Force a browser: chawan, cha, w3m, lynx, links, elinks,
#                         or carbonyl (if installed).
#   --no-images           Do not ask the browser to load images.
#   --image-mode MODE     Chawan image mode: auto, kitty, sixel, none.
#   -h, --help            Show this help.
#
# Environment:
#   REX_BROWSER           Default browser name (same values as --browser).
#   REX_BROWSER_IMAGES    Set to 0 to disable images.
#   REX_BROWSER_IMAGE_MODE
#                         Default Chawan image mode (auto, kitty, sixel, none).
#   CHA_DIR               Chawan configuration directory, if you use one.
#   CHA_LIBEXEC_DIR       Chawan libexec directory, for a non-system install.
#
# The wrapper only passes through what the chosen browser supports. It does
# not download or install anything.

set -eu

# The Rex server may start with a minimal PATH that does not include the
# user's bin directories or Homebrew. Put the usual local locations first so
# a user-local or Homebrew chawan/cha is found, without overriding the rest of
# PATH.
if [ -n "${HOME:-}" ]; then
  PATH="$HOME/.local/bin:$HOME/.config/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
  export PATH
fi

usage() {
  sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'
}

browser=${REX_BROWSER:-}
images=${REX_BROWSER_IMAGES:-1}
mode=${REX_BROWSER_IMAGE_MODE:-auto}

while [ $# -gt 0 ]; do
  case "$1" in
    --browser)
      [ $# -ge 2 ] || { echo "rex-browser: --browser needs a value" >&2; exit 2; }
      browser=$2
      shift 2
      ;;
    --no-images)
      images=0
      shift
      ;;
    --images)
      images=1
      shift
      ;;
    --image-mode)
      [ $# -ge 2 ] || { echo "rex-browser: --image-mode needs a value" >&2; exit 2; }
      mode=$2
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "rex-browser: unknown option: $1" >&2
      exit 2
      ;;
    *)
      break
      ;;
  esac
done

if [ $# -eq 0 ]; then
  echo "rex-browser: a URL is required" >&2
  usage >&2
  exit 2
fi

if [ -n "$browser" ]; then
  if ! command -v "$browser" >/dev/null 2>&1; then
    echo "rex-browser: browser not found: $browser" >&2
    exit 127
  fi
  chosen=$browser
else
  chosen=
  for candidate in chawan cha w3m lynx links elinks; do
    if command -v "$candidate" >/dev/null 2>&1; then
      chosen=$candidate
      break
    fi
  done
  if [ -z "$chosen" ]; then
    echo "rex-browser: no text browser found. Install chawan, w3m, lynx, or links." >&2
    exit 127
  fi
fi

case "$chosen" in
  chawan|cha)
    # Chawan uses -o for one-off config overrides, so we do not write a
    # config file. A system package already knows where its libexec dir is.
    set -- -o "buffer.images=$([ "$images" = 1 ] && echo true || echo false)" \
           -o "display.image-mode=$mode" \
           "$@"
    exec "$chosen" "$@"
    ;;
  *)
    exec "$chosen" "$@"
    ;;
esac
