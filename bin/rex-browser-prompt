#!/bin/sh
# Ask for a URL and hand it to rex-browser in the same pane.
#
# Designed to run inside a floating Rex terminal. Pressing Enter with an empty
# line exits; the caller decides whether the pane closes.

set -eu

printf 'URL: '
IFS= read -r url || exit 0

# Strip surrounding whitespace without relying on bash.
url=$(printf '%s' "$url" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
[ -n "$url" ] || exit 0

case "$url" in
  *://*) ;;
  *) url="https://$url" ;;
esac

exec "${REX_BROWSER_BIN:-rex-browser}" "$url"
