# Non-secret rclone configuration for the "gdrive" remote.
#
# Loaded by bin/rclone-backup and the rclone-drive.service systemd unit. rclone
# is always invoked with an empty config (--config=), so it reads everything
# from environment variables and never writes a config file. Secrets (OAuth
# client + token) live in the repo-root .env — see .env.example.
#
# This directory is deliberately not stowed: nothing belongs under
# ~/.config/rclone, precisely so rclone cannot write a config file.

RCLONE_CONFIG_GDRIVE_TYPE=drive
RCLONE_CONFIG_GDRIVE_SCOPE=drive
